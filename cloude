#include <iostream>
#include <thread>
#include <vector>
#include <deque>
#include <array>
#include <mutex>
#include <condition_variable>
#include <functional>
#include <future>
#include <atomic>
#include <optional>
#include <stdexcept>
#include <chrono>
using namespace std;

// ─── Priority ────────────────────────────────────────────────────
enum class Priority { LOW = 0, NORMAL = 1, HIGH = 2 };

// ─── Task ────────────────────────────────────────────────────────
struct Task {
    Priority priority     = Priority::NORMAL;
    int sequence_number   = 0;
    function<void()> work = nullptr;
};

// ─── BucketedPriorityDeque ───────────────────────────────────────
class BucketedPriorityDeque {
private:
    array<deque<Task>, 3> buckets;  // [LOW][NORMAL][HIGH]
    mutable mutex m;
    size_t total = 0;

    static int idx(Priority p) { return static_cast<int>(p); }

public:
    void push(Task task) {
        lock_guard<mutex> lock(m);
        buckets[idx(task.priority)].push_back(std::move(task));
        total++;
    }

    optional<Task> pop_back() {       // owner — highest priority
        lock_guard<mutex> lock(m);
        for (int i = 2; i >= 0; i--) {
            if (!buckets[i].empty()) {
                Task t = std::move(buckets[i].back());
                buckets[i].pop_back();
                total--;
                return t;
            }
        }
        return nullopt;
    }

    optional<Task> steal_front() {    // thief — lowest priority
        lock_guard<mutex> lock(m);
        for (int i = 0; i <= 2; i++) {
            if (!buckets[i].empty()) {
                Task t = std::move(buckets[i].front());
                buckets[i].pop_front();
                total--;
                return t;
            }
        }
        return nullopt;
    }

    bool empty() const {
        lock_guard<mutex> lock(m);
        return total == 0;
    }

    size_t size() const {
        lock_guard<mutex> lock(m);
        return total;
    }
};

// ─── HybridThreadPool ────────────────────────────────────────────
class HybridThreadPool {
private:
    struct Worker {
        BucketedPriorityDeque deque;
        mutex cv_m;
        condition_variable cv;
        thread t;
        int id = 0;
    };

    vector<unique_ptr<Worker>> workers;
    atomic<bool> stop_flag{false};
    atomic<int>  next_worker{0};
    atomic<int>  sequence_counter{0};

    // ── stealing ─────────────────────────────────────────────────
    optional<Task> try_steal(int my_id) {
        int n = workers.size();

        // busiest-first
        int busiest = -1;
        size_t max_sz = 0;
        for (int i = 0; i < n; i++) {
            if (i == my_id) continue;
            size_t s = workers[i]->deque.size();
            if (s > max_sz) { max_sz = s; busiest = i; }
        }
        if (busiest >= 0 && max_sz > 0) {
            auto t = workers[busiest]->deque.steal_front();
            if (t) return t;
        }

        // random fallback
        for (int i = 0; i < n; i++) {
            int target = (my_id + 1 + i) % n;
            if (target == my_id) continue;
            auto t = workers[target]->deque.steal_front();
            if (t) return t;
        }
        return nullopt;
    }

    // ── task execution ───────────────────────────────────────────
    void run_task(int id, Task task) {
        try {
            task.work();
        } catch (const exception& e) {
            cerr << "Worker " << id
                 << " exception: " << e.what() << "\n";
        } catch (...) {
            cerr << "Worker " << id << " unknown exception\n";
        }
    }

    // ── worker loop ──────────────────────────────────────────────
    void worker_loop(int my_id) {
        Worker& me = *workers[my_id];

        while (true) {

            // 1. drain own queue completely
            while (true) {
                auto task = me.deque.pop_back();
                if (!task) break;
                run_task(my_id, std::move(*task));
            }

            // 2. try stealing
            {
                auto task = try_steal(my_id);
                if (task) {
                    run_task(my_id, std::move(*task));
                    continue;
                }
            }

            // 3. check shutdown before sleeping
            if (stop_flag.load() && me.deque.empty()) {
                // drain any remaining stolen tasks
                while (true) {
                    auto task = try_steal(my_id);
                    if (!task) break;
                    run_task(my_id, std::move(*task));
                }
                return;  // clean exit ✅
            }

            // 4. sleep on per-worker cv
            {
                unique_lock<mutex> lock(me.cv_m);
                me.cv.wait_for(
                    lock,
                    chrono::milliseconds(50),  // fallback for stealing
                    [&] {
                        return stop_flag.load() || !me.deque.empty();
                    }
                );
            }
        }
    }

public:
    explicit HybridThreadPool(int num_threads) {
        workers.reserve(num_threads);
        for (int i = 0; i < num_threads; i++) {
            workers.push_back(make_unique<Worker>());
            workers.back()->id = i;
            workers.back()->t  = thread(
                &HybridThreadPool::worker_loop, this, i
            );
        }
    }

    template<typename F>
    auto submit(F task,
                Priority priority       = Priority::NORMAL,
                int preferred_worker    = -1)
        -> future<decltype(task())>
    {
        using ReturnType = decltype(task());

        if (stop_flag.load())
            throw runtime_error("ThreadPool is stopped");

        auto pt = make_shared<packaged_task<ReturnType()>>(
            std::move(task)
        );
        future<ReturnType> result = pt->get_future();

        int target = (preferred_worker >= 0 &&
                      preferred_worker < (int)workers.size())
            ? preferred_worker
            : next_worker.fetch_add(1) % (int)workers.size();

        workers[target]->deque.push(Task{
            priority,
            sequence_counter.fetch_add(1),
            [pt]() { (*pt)(); }
        });

        workers[target]->cv.notify_one();  // wake exact worker ✅
        return result;
    }

    void shutdown() {
        bool expected = false;
        if (!stop_flag.compare_exchange_strong(expected, true))
            return;

        // wake every worker via its own cv
        for (auto& w : workers) {
            w->cv.notify_all();
        }

        for (auto& w : workers)
            if (w->t.joinable()) w->t.join();
    }

    ~HybridThreadPool() { shutdown(); }

    HybridThreadPool(const HybridThreadPool&) = delete;
    HybridThreadPool& operator=(const HybridThreadPool&) = delete;
};

// ─── Benchmark ───────────────────────────────────────────────────
int main() {
    HybridThreadPool pool(4);

    const int NUM_TASKS = 100;
    vector<future<int>> futures;
    futures.reserve(NUM_TASKS);

    auto start = chrono::steady_clock::now();

    for (int i = 0; i < NUM_TASKS; i++) {
        Priority p = (i % 3 == 0) ? Priority::HIGH
                   : (i % 3 == 1) ? Priority::NORMAL
                                   : Priority::LOW;
        futures.push_back(pool.submit([i]() {
            return i * i;
        }, p));
    }

    int total = 0;
    for (auto& f : futures) total += f.get();

    auto end = chrono::steady_clock::now();
    auto ms  = chrono::duration_cast<chrono::milliseconds>
               (end - start).count();

    cout << "Completed " << NUM_TASKS << " tasks\n";
    cout << "Total: "    << total     << "\n";
    cout << "Time: "     << ms        << "ms\n";

    pool.shutdown();
}